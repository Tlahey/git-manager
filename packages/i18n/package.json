{
  "name": "@git-manager/i18n",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*": "./locales/*"
  },
  "scripts": {
    "lint": "oxlint --type-aware src",
    "typecheck": "tsc --noEmit",
    "translation:check": "node scripts/validate-translations.mts"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@git-manager/config": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
