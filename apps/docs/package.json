{
  "name": "@git-manager/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.ts",
    "dev": "pnpm generate && vitepress dev",
    "build": "pnpm generate && vitepress build",
    "preview": "vitepress preview",
    "lint": "oxlint scripts .vitepress docs.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .vitepress/dist .vitepress/cache .vitepress/sidebar.json .vitepress/landing-css.json docs/features public"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@git-manager/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress": "^1.6.4",
    "vitest": "catalog:",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "@git-manager/mascot": "workspace:*",
    "medium-zoom": "^1.1.0"
  }
}
