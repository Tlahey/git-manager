{
  "name": "@git-manager/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:config": "node check-config-file.ts",
    "test:e2e": "caffeinate -dims wdio run ./wdio.conf.ts",
    "screenshots": "caffeinate -dims wdio run ./wdio.conf.ts --cucumberOpts.tags='@screenshots'",
    "docs:screenshots": "caffeinate -dims wdio run ./wdio.conf.ts --cucumberOpts.tags='@doc'"
  },
  "devDependencies": {
    "@git-manager/config": "workspace:*",
    "@types/node": "catalog:",
    "@wdio/cli": "^9.30.1",
    "@wdio/cucumber-framework": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/native-types": "^2.5.0",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-service": "^1.3.0",
    "@wdio/types": "^9.30.1",
    "@wdio/visual-service": "^10.1.0",
    "typescript": "catalog:"
  }
}
