{
  "productName": "git-manager",
  "version": "0.2.1",
  "identifier": "com.git-manager.app",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost tauri:; worker-src 'self' blob: data:; frame-src 'self' blob:; img-src 'self' blob: data: asset: http://asset.localhost https:; media-src 'self' blob: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline';",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/menu/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MUY0NEYxRDBBNzE3NApSV1IwY1FvZFQvUkJDbG5BOEd3NFpLUVJRejhGVTNCb2JsM2dKcVRlckhrbFBrQlFidDIyQ1VmRAo=",
      "endpoints": [
        "https://github.com/Tlahey/git-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
