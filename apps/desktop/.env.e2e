VITE_E2E=true
# Pins the run to the known set of invented pull requests / issues / contributions. Without it the
# Launchpad is empty in an e2e build: `lib/devFixtures.ts` folds the fixtures out of any bundle that
# is neither a dev build nor explicitly asking for them, and an e2e build is a release build. That
# module's own doc comment names this variable as the supported way to arm them for a
# non-interactive run.
VITE_MOCK_GITHUB=true
