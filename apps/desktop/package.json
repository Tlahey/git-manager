{
  "name": "@git-manager/desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/free-dev-port.mjs && tauri dev",
    "dev:frontend": "vite",
    "build": "tauri build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run themesRegistry userThemeValidation",
    "build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "clean": "rm -rf dist && cargo clean -p git-manager --manifest-path src-tauri/Cargo.toml",
    "clean:deps": "rm -rf dist && cargo clean --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@git-manager/ai": "workspace:*",
    "@git-manager/components": "workspace:*",
    "@git-manager/editor": "workspace:*",
    "@git-manager/git-types": "workspace:*",
    "@git-manager/i18n": "workspace:*",
    "@git-manager/mascot": "workspace:*",
    "@git-manager/notch": "workspace:*",
    "@git-manager/theme": "workspace:*",
    "@git-manager/ui": "workspace:*",
    "@monaco-editor/react": "catalog:",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "catalog:",
    "mermaid": "^11.17.2",
    "monaco-editor": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.0",
    "tw-animate-css": "catalog:",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@git-manager/config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/tauri-plugin": "^1.3.0",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "catalog:"
  }
