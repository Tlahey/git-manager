# Tauri updater signing keypair — private key must never be committed; it lives only in the
# GitHub Actions secret (TAURI_SIGNING_PRIVATE_KEY). See .github/workflows/release.yml.
apps/desktop/.updater-keys/

# Vitest browser-mode artifacts (failure screenshots, APCA a11y reports)
__screenshots__/
a11y-report/

# Documentation site output — everything below is written by
# apps/docs/scripts/generate.ts from the .feature files and docs/screenshots/,
# and regenerated on every dev/build run. The sources are what's committed.
apps/docs/docs/features/
apps/docs/public/
apps/docs/.vitepress/sidebar.json
apps/docs/.vitepress/landing-css.json
apps/docs/.vitepress/cache/

# Raw per-worker wdio logs and the timing rows REPORT.md is built from. The report itself IS
# committed — see apps/e2e/REPORT.md.
apps/e2e/logs/
